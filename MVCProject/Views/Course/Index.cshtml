@model List<Course>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <!-- Title Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 title-card">

        <div class="card-body py-2 px-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h4 class="fw-bold mb-0">
                        All Courses
                    </h4>

                    <p class="text-muted mb-0 mt-1">
                        Manage all courses in one place.
                    </p>

                </div>

                <a asp-action="New" asp-controller="Course" class="btn btn-primary rounded-pill px-4">

                    <i class="bi bi-plus-circle me-2"></i>
                    Add Course

                </a>

            </div>

        </div>

    </div>

    <!-- Search -->
    <form method="get" asp-action="Index" asp-controller="Course" class="mb-4">

        <div class="input-group">

            <input type="text" name="searchText" class="form-control rounded-start-pill" placeholder="Search course..." />

            <button type="submit" class="btn btn-primary rounded-end-pill px-4">

                <i class="bi bi-search me-1"></i>
                Search

            </button>

        </div>

    </form>

    @if (ViewBag.Msg != null)
    {
        <div class="alert alert-warning text-center rounded-4">
            <i class="bi bi-search me-2"></i>
            @ViewBag.Msg
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4">

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead class="table-header">

                        <tr>

                            <th>Course</th>
                            <th>Department</th>
                            <th>Degree</th>
                            <th>Hours</th>
                            <th>Instructor</th>
                            <th class="text-center">Actions</th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <div class="fw-bold"> @item.Name </div>
                                </td>

                                <td>
                                    @item.Department?.Name
                                </td>

                                <td>
                                    @item.Degree
                                </td>

                                <td>
                                    <i class="bi bi-clock me-1 text-secondary"></i>
                                    @item.Hours
                                </td>

                                <td>
                                    @item.Instructors?.FirstOrDefault()?.Name
                                </td>

                                <td class="text-center">

                                    <!-- Details -->
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-primary btn-sm action-btn me-1" title="Details">
                                        <i class="bi bi-eye-fill"></i>
                                    </a>

                                    <!-- Edit -->
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success btn-sm action-btn me-1" title="Edit">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    <!-- Delete -->
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm action-btn" title="Delete">
                                        <i class="bi bi-trash-fill"></i>
                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>