@model List<Instructor>

<a href="/Instructor/New">New</a>

<h2>All Instructors</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Salary</th>
            <th>Address</th>
            <th>Image</th>
            <th>Details</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Id</td>
                <td>@item.Name</td>
                <td>@item.Salary</td>
                <td>@item.Address</td>
                <td>
                    <img src="/Images/@item.ImageUrl" width="80" height="80" />
                </td>
                <td>
                    <a href="/Instructor/DetailsVM/@item.Id" class="btn btn-success">
                     Details
                    </a>
                </td>
               
            </tr>
        }
    </tbody>
</table>