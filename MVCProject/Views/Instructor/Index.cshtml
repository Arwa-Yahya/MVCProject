@model List<Instructor>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">

    <div class="card border-0 shadow-sm rounded-4 mb-4 title-card">

        <div class="card-body py-2 px-4">

            <div class="d-flex justify-content-between align-items-center">

                <div>

                    <h4 class="fw-bold mb-1">
                        All Instructors
                    </h4>

                    <p class="text-muted mb-0">
                        Manage all instructors in one place.
                    </p>

                </div>

                <a asp-action="New" asp-controller="Instructor" class="btn btn-primary rounded-pill px-4">

                    <i class="bi bi-plus-circle me-2"></i>
                    Add Instructor

                </a>

            </div>

        </div>

    </div>

    <div class="card shadow-sm border-0 rounded-4">

        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead class="table-header">

                    <tr>

                        <th>Instructor</th>
                        <th>Salary</th>
                        <th>Address</th>
                        <th>Image</th>
                        <th class="text-center">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>

                                @item.Name

                            </td>

                            <td>

                                @item.Salary

                            </td>

                            <td>

                                @item.Address

                            </td>

                            <td>

                                <img src="/Images/@item.ImageUrl"
                                     width="50"
                                     height="50"
                                     class="rounded-circle border shadow-sm"
                                     style="object-fit:cover;" />

                            </td>

                            <td class="text-center">

                                <!-- Details -->
                                <a asp-action="DetailsVM" asp-route-id="@item.Id" class="btn btn-primary btn-sm action-btn me-1" title="Details">

                                    <i class="bi bi-eye-fill"></i>

                                </a>

                                <!-- Edit -->
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success btn-sm action-btn me-1" title="Edit">

                                    <i class="bi bi-pencil-fill"></i>

                                </a>

                                <!-- Delete -->
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm action-btn" title="Delete">

                                    <i class="bi bi-trash-fill"></i>

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>